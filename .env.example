# Bu dosyayı .env olarak kopyalayıp doldurun. .env asla commit'lenmez.

# --- Meta (Instagram + Facebook) ---
# Meta for Developers'ta uygulama → izinler: instagram_basic, instagram_content_publish,
# instagram_manage_insights, pages_show_list, pages_manage_posts, pages_read_engagement
# Yorum yanıtları için ayrıca: instagram_manage_comments, pages_read_user_content, pages_manage_engagement
# Uzun ömürlü SAYFA erişim tokenı kullanın.
META_API_SURUMU=v23.0
META_ERISIM_TOKENI=
META_SAYFA_ID=
META_IG_KULLANICI_ID=

# --- YouTube ---
# Google Cloud → YouTube Data API v3 → OAuth istemcisi (Masaüstü uygulaması)
# Token için: python -m araclar.youtube_yetkilendir istemci_sirri.json
# (Yorum yanıtları youtube.force-ssl kapsamı ister; eski token varsa bu komutu yeniden çalıştırın.)
YOUTUBE_ISTEMCI_ID=
YOUTUBE_ISTEMCI_SIRRI=
YOUTUBE_YENILEME_TOKENI=

# --- TikTok ---
# developers.tiktok.com → Content Posting API (video.publish, video.list kapsamları)
TIKTOK_ISTEMCI_ANAHTARI=
TIKTOK_ISTEMCI_SIRRI=
TIKTOK_YENILEME_TOKENI=
